{
  "datasets": [
    {
      "name": "2cff891a",
      "displayName": "Trip KPIs",
      "queryLines": [
        "SELECT * FROM workspace.trip.dash_kpis"
      ]
    },
    {
      "name": "b38a9f92",
      "displayName": "workspace trip route overview dataset",
      "queryLines": [
        "SELECT * FROM workspace.trip.dash_route"
      ]
    },
    {
      "name": "route",
      "displayName": "Route",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.trip.dash_route"
      ],
      "columns": [
        {
          "displayName": "Speed Band",
          "description": "Route map colour key: recorded km banded by average speed (same bands as the Speed Bands table); estimated km labelled 'Estimated'",
          "expression": "CASE WHEN `is_imputed` THEN 'Estimated' ELSE CASE WHEN `speed_kmh` < 40 THEN 'Under 40' WHEN `speed_kmh` < 60 THEN '40 to 60' WHEN `speed_kmh` < 80 THEN '60 to 80' WHEN `speed_kmh` < 100 THEN '80 to 100' WHEN `speed_kmh` < 110 THEN '100 to 110' ELSE '110 and over' END END"
        }
      ]
    },
    {
      "name": "daily",
      "displayName": "Daily",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.trip.dash_daily\n",
        "ORDER BY\n",
        "  day_number"
      ],
      "columns": [
        {
          "displayName": "Is Riding Day",
          "description": "1 for days with riding, 0 for rest days",
          "expression": "CASE WHEN `total_km` > 0 THEN 1 ELSE 0 END"
        }
      ]
    },
    {
      "name": "records",
      "displayName": "Records",
      "queryLines": [
        "SELECT\n",
        "  record,\n",
        "  value,\n",
        "  unit,\n",
        "  local_date,\n",
        "  detail\n",
        "FROM\n",
        "  workspace.trip.dash_records\n",
        "ORDER BY\n",
        "  sort_order"
      ]
    },
    {
      "name": "speed_bands",
      "displayName": "Speed Bands",
      "queryLines": [
        "SELECT\n",
        "  speed_band,\n",
        "  hours,\n",
        "  pct_of_riding_time\n",
        "FROM\n",
        "  workspace.trip.dash_speed_bands\n",
        "ORDER BY\n",
        "  band_order"
      ]
    }
  ],
